<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>MCP Explorer</title>

<style>
:root {
    --bg: #0b0d10;
    --panel: #11151a;
    --panel2: #171c22;
    --border: #28303a;
    --text: #f2f5f7;
    --muted: #8d98a5;
    --accent: #7c5cff;
    --accent2: #9b86ff;
    --danger: #ff5c70;
    --success: #43d17b;
    --shadow: 0 12px 40px rgba(0,0,0,.25);
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    background: var(--bg);
    color: var(--text);
}

/* ---------------- HEADER ---------------- */

header {
    position: sticky;
    top: 0;
    z-index: 20;

    backdrop-filter: blur(18px);
    background: rgba(11,13,16,.82);

    border-bottom: 1px solid var(--border);
}

.header-inner {
    max-width: 1450px;
    margin: auto;

    padding: 16px 22px;

    display: flex;
    align-items: center;
    gap: 18px;
}

.logo {
    display: flex;
    align-items: center;
    gap: 10px;

    font-size: 19px;
    font-weight: 800;

    white-space: nowrap;
}

.logo-icon {
    width: 34px;
    height: 34px;

    display: grid;
    place-items: center;

    border-radius: 10px;

    background:
        linear-gradient(
            135deg,
            #7c5cff,
            #4da6ff
        );

    box-shadow:
        0 5px 25px rgba(124,92,255,.35);
}

.search {
    flex: 1;
    max-width: 720px;

    position: relative;
}

.search input {
    width: 100%;

    padding: 13px 46px 13px 16px;

    border-radius: 12px;

    border: 1px solid var(--border);

    outline: none;

    background: var(--panel);

    color: var(--text);

    font-size: 14px;
}

.search input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(124,92,255,.12);
}

.search-icon {
    position: absolute;
    right: 15px;
    top: 50%;

    transform: translateY(-50%);

    color: var(--muted);
}

.icon-button {
    border: 1px solid var(--border);

    background: var(--panel);

    color: var(--text);

    width: 42px;
    height: 42px;

    border-radius: 10px;

    cursor: pointer;

    font-size: 17px;
}

.icon-button:hover {
    border-color: var(--accent);
}

/* ---------------- LAYOUT ---------------- */

.app {
    max-width: 1450px;
    margin: auto;

    display: grid;

    grid-template-columns: 250px 1fr;

    min-height: calc(100vh - 70px);
}

/* ---------------- SIDEBAR ---------------- */

.sidebar {
    border-right: 1px solid var(--border);

    padding: 25px 16px;
}

.sidebar h3 {
    font-size: 12px;

    color: var(--muted);

    text-transform: uppercase;

    letter-spacing: .08em;

    margin: 10px 10px 12px;
}

.nav-button {
    width: 100%;

    display: flex;

    align-items: center;

    gap: 10px;

    padding: 10px 12px;

    border: 0;

    background: transparent;

    color: var(--muted);

    border-radius: 9px;

    cursor: pointer;

    text-align: left;
}

.nav-button:hover,
.nav-button.active {
    background: var(--panel2);
    color: var(--text);
}

.sidebar-info {
    margin-top: 30px;

    padding: 14px;

    border: 1px solid var(--border);

    background: var(--panel);

    border-radius: 12px;

    font-size: 12px;

    color: var(--muted);

    line-height: 1.5;
}

/* ---------------- CONTENT ---------------- */

.content {
    padding: 30px;
}

.hero {
    margin-bottom: 25px;
}

.hero h1 {
    margin: 0 0 8px;

    font-size: 32px;
}

.hero p {
    margin: 0;

    color: var(--muted);

    max-width: 700px;
}

/* ---------------- TOOLBAR ---------------- */

.toolbar {
    display: flex;

    gap: 10px;

    align-items: center;

    margin-bottom: 20px;

    flex-wrap: wrap;
}

.filter {
    padding: 9px 12px;

    background: var(--panel);

    color: var(--text);

    border: 1px solid var(--border);

    border-radius: 9px;

    outline: none;
}

.stats {
    margin-left: auto;

    display: flex;

    gap: 12px;

    color: var(--muted);

    font-size: 13px;
}

/* ---------------- GRID ---------------- */

.grid {
    display: grid;

    grid-template-columns:
        repeat(
            auto-fill,
            minmax(310px, 1fr)
        );

    gap: 15px;
}

/* ---------------- CARD ---------------- */

.card {
    position: relative;

    background: var(--panel);

    border: 1px solid var(--border);

    border-radius: 15px;

    padding: 18px;

    cursor: pointer;

    transition:
        transform .15s,
        border-color .15s,
        box-shadow .15s;
}

.card:hover {
    transform: translateY(-2px);

    border-color: #424c58;

    box-shadow: var(--shadow);
}

.card-top {
    display: flex;

    align-items: flex-start;

    gap: 12px;
}

.server-icon {
    width: 42px;
    height: 42px;

    display: grid;
    place-items: center;

    border-radius: 11px;

    background: var(--panel2);

    border: 1px solid var(--border);

    font-size: 20px;

    flex-shrink: 0;
}

.card h2 {
    font-size: 15px;

    margin: 1px 0 5px;

    word-break: break-word;
}

.server-name {
    color: var(--muted);

    font-size: 11px;

    word-break: break-all;
}

.description {
    color: #b4bdc8;

    font-size: 13px;

    line-height: 1.55;

    margin: 15px 0;

    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;

    overflow: hidden;
}

.card-footer {
    display: flex;

    align-items: center;

    gap: 7px;

    flex-wrap: wrap;
}

.badge {
    padding: 4px 8px;

    border-radius: 6px;

    background: var(--panel2);

    border: 1px solid var(--border);

    font-size: 10px;

    color: var(--muted);
}

.badge.success {
    color: var(--success);

    border-color:
        rgba(67,209,123,.25);
}

.favorite {
    margin-left: auto;

    border: 0;

    background: transparent;

    color: var(--muted);

    cursor: pointer;

    font-size: 18px;
}

.favorite.active {
    color: #ffca3a;
}

/* ---------------- PAGINATION ---------------- */

.pagination {
    display: flex;

    justify-content: center;

    gap: 10px;

    padding: 30px 0;
}

.page-button {
    padding: 9px 15px;

    border-radius: 9px;

    border: 1px solid var(--border);

    background: var(--panel);

    color: var(--text);

    cursor: pointer;
}

.page-button:hover:not(:disabled) {
    border-color: var(--accent);
}

.page-button:disabled {
    opacity: .4;

    cursor: not-allowed;
}

/* ---------------- MODAL ---------------- */

.modal {
    position: fixed;

    inset: 0;

    z-index: 100;

    display: none;

    background: rgba(0,0,0,.7);

    backdrop-filter: blur(8px);

    padding: 30px;
}

.modal.open {
    display: flex;

    align-items: center;

    justify-content: center;
}

.modal-box {
    width: min(1000px, 100%);

    max-height: 90vh;

    overflow: auto;

    background: var(--panel);

    border: 1px solid var(--border);

    border-radius: 18px;

    box-shadow: 0 30px 100px rgba(0,0,0,.5);
}

.modal-header {
    position: sticky;

    top: 0;

    z-index: 2;

    background: rgba(17,21,26,.95);

    backdrop-filter: blur(15px);

    border-bottom: 1px solid var(--border);

    padding: 18px 22px;

    display: flex;

    align-items: center;

    gap: 12px;
}

.modal-header h2 {
    margin: 0;

    font-size: 18px;

    flex: 1;
}

.close {
    border: 0;

    background: transparent;

    color: var(--muted);

    font-size: 25px;

    cursor: pointer;
}

.modal-body {
    padding: 22px;
}

/* ---------------- DETAILS ---------------- */

.detail-description {
    color: #b9c1cb;

    line-height: 1.6;

    margin-bottom: 20px;
}

.detail-grid {
    display: grid;

    grid-template-columns:
        repeat(
            auto-fit,
            minmax(220px, 1fr)
        );

    gap: 10px;

    margin-bottom: 20px;
}

.detail-item {
    padding: 13px;

    border: 1px solid var(--border);

    border-radius: 10px;

    background: var(--panel2);
}

.detail-item label {
    display: block;

    font-size: 10px;

    text-transform: uppercase;

    letter-spacing: .06em;

    color: var(--muted);

    margin-bottom: 5px;
}

.detail-item span {
    font-size: 13px;

    word-break: break-word;
}

.section {
    margin-top: 25px;
}

.section h3 {
    font-size: 14px;

    margin-bottom: 10px;
}

.package {
    border: 1px solid var(--border);

    background: var(--panel2);

    border-radius: 11px;

    padding: 14px;

    margin-bottom: 10px;
}

.package-title {
    font-weight: 700;

    margin-bottom: 8px;
}

.package-row {
    display: flex;

    justify-content: space-between;

    gap: 10px;

    padding: 5px 0;

    font-size: 12px;
}

.package-row span:first-child {
    color: var(--muted);
}

.code {
    position: relative;

    background: #080a0d;

    border: 1px solid var(--border);

    border-radius: 10px;

    padding: 14px;

    overflow: auto;

    font-family:
        "SFMono-Regular",
        Consolas,
        monospace;

    font-size: 12px;

    line-height: 1.6;

    white-space: pre;
}

.copy-button {
    padding: 6px 9px;

    border: 1px solid var(--border);

    border-radius: 7px;

    background: var(--panel);

    color: var(--text);

    cursor: pointer;

    font-size: 11px;
}

.code-wrap {
    position: relative;
}

.code-wrap .copy-button {
    position: absolute;

    top: 8px;
    right: 8px;
}

/* ---------------- LOADING ---------------- */

.loading {
    min-height: 300px;

    display: grid;

    place-items: center;

    color: var(--muted);
}

.spinner {
    width: 28px;
    height: 28px;

    border: 3px solid var(--border);

    border-top-color: var(--accent);

    border-radius: 50%;

    animation: spin .7s linear infinite;

    margin: auto auto 12px;
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}

.error {
    padding: 18px;

    border: 1px solid
        rgba(255,92,112,.3);

    background:
        rgba(255,92,112,.08);

    color: #ff9aa7;

    border-radius: 10px;
}

.empty {
    text-align: center;

    padding: 70px 20px;

    color: var(--muted);
}

/* ---------------- TOAST ---------------- */

.toast {
    position: fixed;

    right: 20px;
    bottom: 20px;

    z-index: 200;

    background: var(--panel2);

    border: 1px solid var(--border);

    padding: 12px 15px;

    border-radius: 10px;

    box-shadow: var(--shadow);

    transform:
        translateY(30px);

    opacity: 0;

    pointer-events: none;

    transition: .2s;
}

.toast.show {
    transform: translateY(0);

    opacity: 1;
}

/* ---------------- RESPONSIVE ---------------- */

@media(max-width: 800px) {

    .app {
        grid-template-columns: 1fr;
    }

    .sidebar {
        display: none;
    }

    .content {
        padding: 18px;
    }

    .header-inner {
        padding: 12px;
    }

    .logo span {
        display: none;
    }

    .hero h1 {
        font-size: 25px;
    }

    .stats {
        width: 100%;
        margin-left: 0;
    }

    .modal {
        padding: 10px;
    }
}
</style>
</head>

<body>

<header>
    <div class="header-inner">

        <div class="logo">
            <div class="logo-icon">M</div>
            <span>MCP Explorer</span>
        </div>

        <div class="search">
            <input
                id="searchInput"
                placeholder="Search MCP servers..."
                autocomplete="off"
            >

            <span class="search-icon">⌕</span>
        </div>

        <button
            class="icon-button"
            id="themeButton"
            title="Toggle theme"
        >
            ☾
        </button>

    </div>
</header>


<div class="app">

    <aside class="sidebar">

        <h3>Browse</h3>

        <button
            class="nav-button active"
            data-view="all"
        >
            🧰 All Servers
        </button>

        <button
            class="nav-button"
            data-view="favorites"
        >
            ⭐ Favorites
        </button>

        <h3>Filters</h3>

        <button
            class="nav-button"
            id="latestButton"
        >
            ⚡ Latest versions
        </button>

        <button
            class="nav-button"
            id="resetButton"
        >
            ↺ Reset
        </button>

        <div class="sidebar-info">

            <strong>MCP Registry</strong>

            <br><br>

            This interface reads public MCP
            server metadata directly from the
            official registry API.

            <br><br>

            No API key is required for
            read-only discovery.

        </div>

    </aside>


    <main class="content">

        <section class="hero">

            <h1>Model Context Protocol</h1>

            <p>
                Discover MCP servers, inspect their
                packages and installation metadata,
                view versions, and copy configurations.
            </p>

        </section>


        <div class="toolbar">

            <select
                id="versionFilter"
                class="filter"
            >
                <option value="latest">
                    Latest versions
                </option>

                <option value="">
                    All versions
                </option>
            </select>

            <button
                class="filter"
                id="refreshButton"
            >
                ↻ Refresh
            </button>

            <div
                class="stats"
                id="stats"
            >
                Loading...
            </div>

        </div>


        <section id="results">

            <div class="loading">

                <div>
                    <div class="spinner"></div>

                    Loading MCP servers...
                </div>

            </div>

        </section>


        <div
            class="pagination"
            id="pagination"
        ></div>

    </main>

</div>


<!-- DETAILS MODAL -->

<div
    class="modal"
    id="modal"
>

    <div class="modal-box">

        <div class="modal-header">

            <h2 id="modalTitle">
                MCP Server
            </h2>

            <button
                class="close"
                id="closeModal"
            >
                ×
            </button>

        </div>

        <div
            class="modal-body"
            id="modalBody"
        ></div>

    </div>

</div>


<div
    class="toast"
    id="toast"
>
    Copied!
</div>


<script>

/*
====================================================
CONFIGURATION
====================================================
*/

const API =
    "https://registry.modelcontextprotocol.io/v0.1";


/*
====================================================
STATE
====================================================
*/

const state = {

    search: "",

    version: "latest",

    cursor: null,

    previousCursors: [],

    servers: [],

    view: "all",

    favorites:
        JSON.parse(
            localStorage.getItem(
                "mcp-favorites"
            ) || "[]"
        )

};


/*
====================================================
DOM
====================================================
*/

const results =
    document.getElementById("results");

const searchInput =
    document.getElementById("searchInput");

const versionFilter =
    document.getElementById("versionFilter");

const pagination =
    document.getElementById("pagination");

const stats =
    document.getElementById("stats");

const modal =
    document.getElementById("modal");

const modalTitle =
    document.getElementById("modalTitle");

const modalBody =
    document.getElementById("modalBody");

const toast =
    document.getElementById("toast");


/*
====================================================
HELPERS
====================================================
*/

function escapeHTML(value) {

    if (value === null ||
        value === undefined) {

        return "";
    }

    return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
}


function getName(server) {

    return (
        server.server?.title ||
        server.server?.name ||
        server.name ||
        "Unnamed MCP Server"
    );
}


function getDescription(server) {

    return (
        server.server?.description ||
        server.description ||
        "No description available."
    );
}


function getRawServer(server) {

    return server.server || server;
}


function isFavorite(server) {

    const name =
        getRawServer(server).name;

    return state.favorites.includes(name);
}


function toggleFavorite(
    event,
    server
) {

    event.stopPropagation();

    const name =
        getRawServer(server).name;

    if (state.favorites.includes(name)) {

        state.favorites =
            state.favorites.filter(
                x => x !== name
            );

    } else {

        state.favorites.push(name);

    }

    localStorage.setItem(
        "mcp-favorites",
        JSON.stringify(
            state.favorites
        )
    );

    render();
}


function showToast(message) {

    toast.textContent = message;

    toast.classList.add("show");

    setTimeout(
        () => toast.classList.remove("show"),
        1800
    );
}


async function copyText(text) {

    await navigator.clipboard.writeText(
        text
    );

    showToast("Copied to clipboard");
}


/*
====================================================
API
====================================================
*/

async function api(
    endpoint
) {

    const response =
        await fetch(
            API + endpoint,
            {
                headers: {
                    "Accept":
                        "application/json"
                }
            }
        );

    if (!response.ok) {

        throw new Error(
            `HTTP ${response.status}`
        );

    }

    return response.json();
}


/*
====================================================
LOAD SERVERS
====================================================
*/

async function loadServers() {

    results.innerHTML = `
        <div class="loading">
            <div>
                <div class="spinner"></div>
                Searching MCP Registry...
            </div>
        </div>
    `;

    try {

        const params =
            new URLSearchParams();

        params.set("limit", "50");

        if (state.search.trim()) {

            params.set(
                "search",
                state.search.trim()
            );

        }

        if (state.version) {

            params.set(
                "version",
                state.version
            );

        }

        if (state.cursor) {

            params.set(
                "cursor",
                state.cursor
            );

        }

        const data =
            await api(
                "/servers?" +
                params.toString()
            );

        state.servers =
            data.servers || [];

        render();

        updateStats(data);

        renderPagination(data);

    } catch(error) {

        console.error(error);

        results.innerHTML = `
            <div class="error">
                <strong>
                    Failed to load MCP Registry
                </strong>

                <br><br>

                ${escapeHTML(error.message)}

                <br><br>

                Check your internet connection
                or try again.
            </div>
        `;

        stats.textContent =
            "Registry unavailable";
    }

}


/*
====================================================
RENDER
====================================================
*/

function render() {

    let servers =
        state.servers;

    if (
        state.view ===
        "favorites"
    ) {

        servers =
            servers.filter(
                server =>
                    isFavorite(server)
            );

    }

    if (!servers.length) {

        results.innerHTML = `
            <div class="empty">
                <div style="font-size:40px">
                    🔎
                </div>

                <h3>
                    No MCP servers found
                </h3>

                <p>
                    Try a different search.
                </p>
            </div>
        `;

        return;
    }


    const grid =
        document.createElement("div");

    grid.className = "grid";


    servers.forEach(
        server => {

            const card =
                document.createElement(
                    "article"
                );

            card.className = "card";

            const raw =
                getRawServer(server);

            const name =
                getName(server);

            const description =
                getDescription(server);

            const version =
                raw.version ||
                server.version ||
                "unknown";

            const repository =
                raw.repository?.url ||
                "";

            const packages =
                raw.packages || [];

            const favorite =
                isFavorite(server);


            card.innerHTML = `

                <div class="card-top">

                    <div class="server-icon">
                        🧩
                    </div>

                    <div style="flex:1">

                        <h2>
                            ${escapeHTML(name)}
                        </h2>

                        <div class="server-name">
                            ${escapeHTML(
                                raw.name ||
                                "unknown"
                            )}
                        </div>

                    </div>

                    <button
                        class="favorite
                        ${favorite ? "active" : ""}"
                        title="Favorite"
                    >
                        ${favorite ? "★" : "☆"}
                    </button>

                </div>


                <div class="description">
                    ${escapeHTML(
                        description
                    )}
                </div>


                <div class="card-footer">

                    <span class="badge">
                        v${escapeHTML(
                            version
                        )}
                    </span>

                    <span class="badge">
                        ${packages.length}
                        package${packages.length === 1 ? "" : "s"}
                    </span>

                    ${
                        repository
                        ? `
                        <span class="badge">
                            GitHub/source
                        </span>
                        `
                        : ""
                    }

                    ${
                        raw.status
                        ? `
                        <span class="badge success">
                            ${escapeHTML(
                                raw.status
                            )}
                        </span>
                        `
                        : ""
                    }

                </div>

            `;


            card.addEventListener(
                "click",
                () => openDetails(server)
            );


            card.querySelector(
                ".favorite"
            ).addEventListener(
                "click",
                event =>
                    toggleFavorite(
                        event,
                        server
                    )
            );


            grid.appendChild(card);

        }
    );


    results.innerHTML = "";

    results.appendChild(grid);

}


/*
====================================================
STATS
====================================================
*/

function updateStats(data) {

    const count =
        data.metadata?.count ??
        state.servers.length;

    stats.innerHTML =
        `${count} results`;

}


/*
====================================================
PAGINATION
====================================================
*/

function renderPagination(data) {

    pagination.innerHTML = "";

    const previous =
        document.createElement(
            "button"
        );

    previous.className =
        "page-button";

    previous.textContent =
        "← Previous";

    previous.disabled =
        state.previousCursors.length === 0;


    previous.onclick =
        () => {

            if (
                !state.previousCursors.length
            ) return;

            state.cursor =
                state.previousCursors.pop();

            loadServers();

        };


    const next =
        document.createElement(
            "button"
        );

    next.className =
        "page-button";

    next.textContent =
        "Next →";

    const nextCursor =
        data.metadata?.nextCursor;


    next.disabled =
        !nextCursor;


    next.onclick =
        () => {

            if (!nextCursor) return;

            state.previousCursors.push(
                state.cursor
            );

            state.cursor =
                nextCursor;

            loadServers();

        };


    pagination.appendChild(previous);

    pagination.appendChild(next);

}


/*
====================================================
SERVER DETAILS
====================================================
*/

async function openDetails(server) {

    const raw =
        getRawServer(server);

    modal.classList.add("open");

    modalTitle.textContent =
        getName(server);

    modalBody.innerHTML = `
        <div class="loading">
            <div>
                <div class="spinner"></div>
                Loading server details...
            </div>
        </div>
    `;


    try {

        const name =
            encodeURIComponent(
                raw.name
            );

        const version =
            encodeURIComponent(
                raw.version ||
                "latest"
            );

        const detail =
            await api(
                `/servers/${name}/versions/${version}`
            );

        renderDetails(detail);

    } catch(error) {

        /*
         * Some registry responses already
         * contain enough information to show
         * useful details, so fall back to the
         * object already loaded.
         */

        renderDetails(server);

    }

}


/*
====================================================
DETAIL RENDERING
====================================================
*/

function renderDetails(data) {

    const raw =
        getRawServer(data);

    const repository =
        raw.repository?.url;

    const website =
        raw.websiteUrl;

    const packages =
        raw.packages || [];


    modalBody.innerHTML = `

        <div class="detail-description">
            ${escapeHTML(
                raw.description ||
                "No description available."
            )}
        </div>


        <div class="detail-grid">

            <div class="detail-item">

                <label>Name</label>

                <span>
                    ${escapeHTML(
                        raw.name
                    )}
                </span>

            </div>


            <div class="detail-item">

                <label>Version</label>

                <span>
                    ${escapeHTML(
                        raw.version ||
                        "unknown"
                    )}
                </span>

            </div>


            <div class="detail-item">

                <label>Title</label>

                <span>
                    ${escapeHTML(
                        raw.title ||
                        "—"
                    )}
                </span>

            </div>


            <div class="detail-item">

                <label>Status</label>

                <span>
                    ${escapeHTML(
                        raw.status ||
                        "active"
                    )}
                </span>

            </div>

        </div>


        <div style="
            display:flex;
            gap:8px;
            flex-wrap:wrap;
            margin-bottom:20px;
        ">

            ${
                repository
                ? `
                <button
                    class="copy-button"
                    onclick="window.open(
                        '${escapeAttribute(repository)}',
                        '_blank'
                    )"
                >
                    Source Repository ↗
                </button>
                `
                : ""
            }


            ${
                website
                ? `
                <button
                    class="copy-button"
                    onclick="window.open(
                        '${escapeAttribute(website)}',
                        '_blank'
                    )"
                >
                    Website ↗
                </button>
                `
                : ""
            }


            <button
                class="copy-button"
                id="copyJson"
            >
                Copy server JSON
            </button>

        </div>


        <div class="section">

            <h3>
                📦 Packages & Installation
            </h3>

            ${
                packages.length
                ? packages.map(
                    renderPackage
                ).join("")
                : `
                    <div class="empty">
                        No package information
                    </div>
                `
            }

        </div>


        <div class="section">

            <h3>
                🧾 Raw server.json
            </h3>

            <div class="code-wrap">

                <button
                    class="copy-button"
                    id="copyRaw"
                >
                    Copy
                </button>

                <pre class="code">${escapeHTML(
                    JSON.stringify(
                        raw,
                        null,
                        2
                    )
                )}</pre>

            </div>

        </div>

    `;


    document
        .getElementById("copyJson")
        ?.addEventListener(
            "click",
            () =>
                copyText(
                    JSON.stringify(
                        raw,
                        null,
                        2
                    )
                )
        );


    document
        .getElementById("copyRaw")
        ?.addEventListener(
            "click",
            () =>
                copyText(
                    JSON.stringify(
                        raw,
                        null,
                        2
                    )
                )
        );

}


/*
====================================================
PACKAGE RENDER
====================================================
*/

function renderPackage(pkg) {

    const registry =
        pkg.registryType ||
        "unknown";

    const identifier =
        pkg.identifier ||
        "unknown";

    const transport =
        pkg.transport?.type ||
        "unknown";

    const args =
        pkg.runtimeArguments ||
        pkg.arguments ||
        [];

    const env =
        pkg.environmentVariables ||
        [];


    return `

        <div class="package">

            <div class="package-title">

                ${escapeHTML(
                    registry
                )}

                <span
                    style="
                        color:var(--muted);
                        font-weight:400;
                    "
                >
                    ·
                    ${escapeHTML(
                        identifier
                    )}
                </span>

            </div>


            <div class="package-row">

                <span>Version</span>

                <span>
                    ${escapeHTML(
                        pkg.version ||
                        "—"
                    )}
                </span>

            </div>


            <div class="package-row">

                <span>Transport</span>

                <span>
                    ${escapeHTML(
                        transport
                    )}
                </span>

            </div>


            ${
                pkg.registryBaseUrl
                ? `
                <div class="package-row">

                    <span>Registry</span>

                    <span>
                        ${escapeHTML(
                            pkg.registryBaseUrl
                        )}
                    </span>

                </div>
                `
                : ""
            }


            ${
                env.length
                ? `

                    <div style="
                        margin-top:12px;
                        color:var(--muted);
                        font-size:11px;
                    ">
                        Environment variables
                    </div>

                    <div
                        style="
                            margin-top:7px;
                            display:flex;
                            gap:5px;
                            flex-wrap:wrap;
                        "
                    >

                        ${env.map(
                            variable => `
                                <span class="badge">
                                    ${escapeHTML(
                                        variable.name ||
                                        variable
                                    )}

                                    ${
                                        variable.isRequired
                                        ? " *"
                                        : ""
                                    }
                                </span>
                            `
                        ).join("")}

                    </div>

                `
                : ""
            }


            ${
                args.length
                ? `

                    <div style="
                        margin-top:12px;
                        color:var(--muted);
                        font-size:11px;
                    ">
                        Runtime arguments
                    </div>

                    <div
                        class="code"
                        style="
                            margin-top:7px;
                            padding:10px;
                        "
                    >${escapeHTML(
                        JSON.stringify(
                            args,
                            null,
                            2
                        )
                    )}</div>

                `
                : ""
            }

        </div>

    `;

}


/*
====================================================
SAFE ATTRIBUTE
====================================================
*/

function escapeAttribute(value) {

    return String(value || "")
        .replaceAll("\\", "\\\\")
        .replaceAll("'", "\\'");
}


/*
====================================================
SEARCH DEBOUNCE
====================================================
*/

let searchTimer;

searchInput.addEventListener(
    "input",
    event => {

        clearTimeout(
            searchTimer
        );

        searchTimer =
            setTimeout(
                () => {

                    state.search =
                        event.target.value;

                    state.cursor = null;

                    state.previousCursors = [];

                    loadServers();

                },
                350
            );

    }
);


/*
====================================================
FILTERS
====================================================
*/

versionFilter.addEventListener(
    "change",
    event => {

        state.version =
            event.target.value;

        state.cursor = null;

        state.previousCursors = [];

        loadServers();

    }
);


document
    .getElementById("refreshButton")
    .addEventListener(
        "click",
        () => loadServers()
    );


document
    .getElementById("latestButton")
    .addEventListener(
        "click",
        () => {

            versionFilter.value =
                "latest";

            state.version =
                "latest";

            state.cursor = null;

            state.previousCursors = [];

            loadServers();

        }
    );


document
    .getElementById("resetButton")
    .addEventListener(
        "click",
        () => {

            searchInput.value = "";

            versionFilter.value =
                "latest";

            state.search = "";

            state.version =
                "latest";

            state.cursor = null;

            state.previousCursors = [];

            state.view = "all";

            document
                .querySelectorAll(
                    ".nav-button"
                )
                .forEach(
                    button =>
                        button.classList
                            .remove("active")
                );

            document
                .querySelector(
                    '[data-view="all"]'
                )
                ?.classList.add(
                    "active"
                );

            loadServers();

        }
    );


/*
====================================================
NAVIGATION
====================================================
*/

document
    .querySelectorAll(
        ".nav-button[data-view]"
    )
    .forEach(
        button => {

            button.addEventListener(
                "click",
                () => {

                    document
                        .querySelectorAll(
                            ".nav-button[data-view]"
                        )
                        .forEach(
                            b =>
                                b.classList
                                    .remove(
                                        "active"
                                    )
                        );

                    button.classList.add(
                        "active"
                    );

                    state.view =
                        button.dataset.view;

                    render();

                }
            );

        }
    );


/*
====================================================
MODAL
====================================================
*/

document
    .getElementById("closeModal")
    .addEventListener(
        "click",
        () =>
            modal.classList.remove(
                "open"
            )
    );


modal.addEventListener(
    "click",
    event => {

        if (
            event.target === modal
        ) {

            modal.classList.remove(
                "open"
            );

        }

    }
);


document.addEventListener(
    "keydown",
    event => {

        if (
            event.key === "Escape"
        ) {

            modal.classList.remove(
                "open"
            );

        }

    }
);


/*
====================================================
THEME
====================================================
*/

document
    .getElementById("themeButton")
    .addEventListener(
        "click",
        () => {

            const light =
                document.body.dataset.theme ===
                "light";

            if (light) {

                delete document.body.dataset.theme;

                document.documentElement
                    .style
                    .setProperty(
                        "--bg",
                        "#0b0d10"
                    );

                document.documentElement
                    .style
                    .setProperty(
                        "--panel",
                        "#11151a"
                    );

                document.documentElement
                    .style
                    .setProperty(
                        "--panel2",
                        "#171c22"
                    );

                document.documentElement
                    .style
                    .setProperty(
                        "--border",
                        "#28303a"
                    );

                document.documentElement
                    .style
                    .setProperty(
                        "--text",
                        "#f2f5f7"
                    );

                document.documentElement
                    .style
                    .setProperty(
                        "--muted",
                        "#8d98a5"
                    );

                document.getElementById(
                    "themeButton"
                ).textContent = "☾";

            } else {

                document.body.dataset.theme =
                    "light";

                document.documentElement
                    .style
                    .setProperty(
                        "--bg",
                        "#f4f6f8"
                    );

                document.documentElement
                    .style
                    .setProperty(
                        "--panel",
                        "#ffffff"
                    );

                document.documentElement
                    .style
                    .setProperty(
                        "--panel2",
                        "#eef1f5"
                    );

                document.documentElement
                    .style
                    .setProperty(
                        "--border",
                        "#dce1e7"
                    );

                document.documentElement
                    .style
                    .setProperty(
                        "--text",
                        "#11151a"
                    );

                document.documentElement
                    .style
                    .setProperty(
                        "--muted",
                        "#66717e"
                    );

                document.getElementById(
                    "themeButton"
                ).textContent = "☀";

            }

        }
    );


/*
====================================================
START
====================================================
*/

loadServers();

</script>

</body>
</html>